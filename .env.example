# Copy this file to .env and fill in your real values.
#   cp .env.example .env
#
# .env is gitignored and must never be committed.
# Every variable here MUST start with EXPO_PUBLIC_ or Expo will not
# expose it to the app bundle.
#
# After editing .env, restart Metro with `npx expo start --clear`.
# These values are inlined at bundle time, so a hot reload will not
# pick up the change.

# ---------------------------------------------------------------------------
# Supabase
# Dashboard -> your project -> Project Settings -> API
# ---------------------------------------------------------------------------

# "Project URL", e.g. https://abcdefghijklm.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# "anon" / "public" key. This one is safe to ship in a client build; it is
# gated by your Row Level Security policies. Do NOT put the service_role
# key here - that one bypasses RLS entirely and must stay server-side.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Google Maps
# Required for the map to render on Android. iOS uses Apple Maps by default
# and works without a key. Without this, Android shows a blank grey grid.
# ---------------------------------------------------------------------------

# Create one at https://console.cloud.google.com/google/maps-apis
# and enable the "Maps SDK for Android". Restrict the key to your Android
# package (com.sizophilandlovu.outside) plus the SHA-1 of your signing key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
